    "\n",
    "# 1. Function f(x)\n",
    "function f(x)\n",
    "    x1, x2, x3 = x[1], x[2], x[3]\n",
    "    if (x1 + x2 <= 0) || (x3 <= 0) return nothing end\n",
    "    return x3 * log(exp(x1/x3) + exp(x2/x3)) + (x3 - 2)^2 + exp(1 / (x1 + x2))\n",
    "end\n",
    "\n",
    "# 2. Analytical Gradient ∇f(x)\n",
    "function grad_f(x)\n",
    "    x1, x2, x3 = x[1], x[2], x[3]\n",
    "    ex1, ex2 = exp(x1/x3), exp(x2/x3)\n",
    "    sum_ex = ex1 + ex2\n",
    "    e_inv_sum = exp(1 / (x1 + x2))\n",
    "    inv_sum_sq = (x1 + x2)^2\n",
    "    \n",
    "    g1 = (ex1 / sum_ex) - (e_inv_sum / inv_sum_sq)\n",
    "    g2 = (ex2 / sum_ex) - (e_inv_sum / inv_sum_sq)\n",
    "    g3 = log(sum_ex) - (x1 * ex1 + x2 * ex2) / (x3 * sum_ex) + 2 * (x3 - 2)\n",
    "    return [g1, g2, g3]\n",
    "end\n",
    "\n",
    "# 3. BFGS Algorithm\n",
    "function solve_bfgs(x0; eps=1e-5, α_back=0.4, β_back=0.5)\n",
    "    x = copy(x0)\n",
    "    n = length(x)\n",
    "    H = I(n) * 1.0  # Initial H_0 as Identity matrix\n",
    "    max_iter = 500\n",
    "    \n",
    "    println(\"Starting BFGS Optimization...\")\n",
    "    println(\"-\"^70)\n",
    "    @printf(\"%-5s %-15s %-12s %-10s\\n\", \"Iter\", \"f(x)\", \"||grad||\", \"Step (α)\")\n",
    "    println(\"-\"^70)\n",
    "\n",
    "    for k in 0:max_iter\n",
    "        fx = f(x)\n",
    "        gx = grad_f(x)\n",
    "        norm_gx = norm(gx)\n",
    "\n",
    "        if k % 5 == 0 || k == 0\n",
    "            @printf(\"%-5d %-15.8f %-12.3e \", k, fx, norm_gx)\n",
    "        end\n",
    "\n",
    "        # Stopping Criterion\n",
    "        if norm_gx < eps\n",
    "            println(\"\\n\" * \"-\"^70)\n",
    "            @printf(\"SUCCESS: Converged at iteration %d\\n\", k)\n",
    "            return x\n",
    "        end\n",
    "\n",
    "        # 1. Search Direction\n",
    "        p = -H * gx\n",
