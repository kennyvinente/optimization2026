   "source": [
    "using Plots\n",
    "\n",
    "# Define the function\n",
    "f(x1, x2) = (x1 - 3)^2 + (x2 + 4)^2\n",
    "\n",
    "# Create a grid of points\n",
    "x1_range = -5:0.1:10  # Range for x1\n",
    "x2_range = -10:0.1:2  # Range for x2\n",
    "\n",
    "# Create the surface plot\n",
    "plot_surface = surface(x1_range, x2_range, f, \n",
    "    xlabel=\"x₁\", \n",
    "    ylabel=\"x₂\", \n",
    "    zlabel=\"f(x₁,x₂)\",\n",
    "    title=\"f(x₁,x₂) = (x₁-3)² + (x₂+4)²\",\n",
    "    camera=(30, 30),  # Adjust viewing angle\n",
    "    legend=false,\n",
    "    colormap=:viridis)\n",
    "\n",
    "# Display the plot\n",
    "display(plot_surface)\n",
    "\n",
    "# Optional: Create a contour plot\n",
    "plot_contour = contour(x1_range, x2_range, f,\n",
    "    xlabel=\"x₁\",\n",
    "    ylabel=\"x₂\",\n",
    "    title=\"Contour Plot of f(x₁,x₂) = (x₁-3)² + (x₂+4)²\",\n",
    "    fill=true,\n",
    "    colormap=:viridis)\n",
    "\n",
    "# Display contour plot\n",
    "display(plot_contour)\n",
    "\n",
    "# Optional: Create a heatmap\n",
    "plot_heatmap = heatmap(x1_range, x2_range, f,\n",
    "    xlabel=\"x₁\",\n",
    "    ylabel=\"x₂\",\n",
    "    title=\"Heatmap of f(x₁,x₂)\",\n",
    "    colormap=:viridis)\n",
    "\n",
    "# Display heatmap\n",
    "display(plot_heatmap)\n",
    "\n",
    "# Optional: Create a combined plot (2x2 grid)\n",
    "combined_plot = plot(\n",
    "    plot_surface, \n",
    "    plot_contour, \n",
    "    plot_heatmap,\n",
    "    layout=(1, 3),\n",
    "    size=(1200, 400)\n",
    ")\n",
    "\n",
    "display(combined_plot)"
