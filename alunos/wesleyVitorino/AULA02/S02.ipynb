     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- RESULTS ---\n",
      "Gradient Descent: Solved at [2.9999995886238606, 1.9999997943119303] in 69 iterations\n",
      "Newton Method:    Solved at [3.0, 2.0] in 1 iterations\n"
     ]
    }
   ],
   "source": [
    "\n",
    "# Define the function and its derivatives\n",
    "f(x) = (x[1] - 3)^2 + (x[2] - 2)^2\n",
    "grad_f(x) = [2*(x[1] - 3), 2*(x[2] - 2)]\n",
    "hess_f(x) = [2.0 0.0; 0.0 2.0]\n",
    "\n",
    "# Initial parameters\n",
    "x0 = [1.0, 1.0]\n",
    "tol = 1e-6\n",
    "max_iter = 100\n",
    "\n",
    "## 1. GRADIENT DESCENT\n",
    "function gradient_descent(x_start, alpha=0.1)\n",
    "    x = copy(x_start)\n",
    "    path = [copy(x)]\n",
    "    for i in 1:max_iter\n",
    "        g = grad_f(x)\n",
    "        if norm(g) < tol break end\n",
    "        x -= alpha * g  # Step: x = x - learning_rate * gradient\n",
    "        push!(path, copy(x))\n",
    "    end\n",
    "    return x, path\n",
    "end\n",
    "\n",
    "## 2. NEWTON METHOD\n",
    "function newton_method(x_start)\n",
    "    x = copy(x_start)\n",
    "    path = [copy(x)]\n",
    "    for i in 1:max_iter\n",
    "        g = grad_f(x)\n",
    "        H = hess_f(x)\n",
    "        if norm(g) < tol break end\n",
    "        x -= H \\ g     # Step: x = x - inv(H) * gradient\n",
    "        push!(path, copy(x))\n",
    "    end\n",
    "    return x, path\n",
    "end\n",
    "\n",
    "# Execute\n",
    "sol_gd, path_gd = gradient_descent(x0)\n",
    "sol_nt, path_nt = newton_method(x0)\n",
    "\n",
    "println(\"--- RESULTS ---\")\n",
    "println(\"Gradient Descent: Solved at $sol_gd in $(length(path_gd)-1) iterations\")\n",
    "println(\"Newton Method:    Solved at $sol_nt in $(length(path_nt)-1) iterations\")\n",
    "\n",
    "## VISUALIZATION\n",
    "x1_rng = range(0, 5, length=100)\n",
    "x2_rng = range(0, 4, length=100)\n",
    "z = [f([x1, x2]) for x1 in x1_rng, x2 in x2_rng]\n",
    "\n",
    "p = contour(x1_rng, x2_rng, z, fill=true, title=\"Optimization Paths\", xlabel=\"x1\", ylabel=\"x2\")\n",
    "\n",
    "# Plot paths\n",
    "gd_pts = hcat(path_gd...)'\n",
    "nt_pts = hcat(path_nt...)'\n",
    "\n",
    "plot!(gd_pts[:,1], gd_pts[:,2], marker=:circle, label=\"Gradient Descent\", color=:white, lw=2)\n",
    "plot!(nt_pts[:,1], nt_pts[:,2], marker=:star, label=\"Newton Method\", color=:red, lw=2)\n",
    "\n",
    "display(p)"
