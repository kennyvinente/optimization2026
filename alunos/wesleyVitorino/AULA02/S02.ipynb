    "# 1. Function f(x)\n",
    "function f(x)\n",
    "    x1, x2, x3 = x[1], x[2], x[3]\n",
    "    if (x1 + x2 <= 0) || (x3 <= 0) return nothing end\n",
    "    return x3 * log(exp(x1/x3) + exp(x2/x3)) + (x3 - 2)^2 + exp(1 / (x1 + x2))\n",
    "end\n",
    "\n",
    "# 2. Gradient Calculation (Analytical)\n",
    "function grad_f(x)\n",
    "    x1, x2, x3 = x[1], x[2], x[3]\n",
    "    ex1, ex2 = exp(x1/x3), exp(x2/x3)\n",
    "    sum_ex = ex1 + ex2\n",
    "    e_inv_sum = exp(1 / (x1 + x2))\n",
    "    inv_sum_sq = (x1 + x2)^2\n",
    "    \n",
    "    g1 = (ex1 / sum_ex) - (e_inv_sum / inv_sum_sq)\n",
    "    g2 = (ex2 / sum_ex) - (e_inv_sum / inv_sum_sq)\n",
    "    g3 = log(sum_ex) - (x1 * ex1 + x2 * ex2) / (x3 * sum_ex) + 2 * (x3 - 2)\n",
    "    return [g1, g2, g3]\n",
    "end\n",
    "\n",
    "# 3. Hessian Approximation (Finite Differences of the Gradient)\n",
    "function hessian_approx(x; h=1e-5)\n",
    "    n = length(x)\n",
    "    H = zeros(n, n)\n",
    "    g_base = grad_f(x)\n",
    "    \n",
    "    for j in 1:n\n",
    "        x_step = copy(x)\n",
    "        x_step[j] += h\n",
    "        g_step = grad_f(x_step)\n",
    "        # H[:, j] ≈ (∇f(x + h*ej) - ∇f(x)) / h\n",
    "        H[:, j] = (g_step - g_base) / h\n",
    "    end\n",
    "    # Symmetrize to handle numerical noise: (H + H')/2\n",
    "    return 0.5 * (H + H')\n",
    "end\n",
    "\n",
    "# 4. Newton's Method with Backtracking\n",
    "function newton_optimization(x0; α=0.4, β=0.5, eps=1e-7)\n",
    "    x = copy(x0)\n",
    "    max_iter = 50\n",
