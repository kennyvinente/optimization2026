   "source": [
    "\n",
    "# Define the function\n",
    "f(x1, x2) = (x1 - 3)^2 + (x2 - 2)^2\n",
    "\n",
    "# Define the domain around the minimum point (3, 2)\n",
    "x1_range = range(0, 6, length=100)\n",
    "x2_range = range(-1, 5, length=100)\n",
    "\n",
    "# 1. Create the Surface Plot\n",
    "p1 = surface(x1_range, x2_range, f, \n",
    "             title=\"Surface Plot of f(x)\", \n",
    "             xlabel=\"x1\", ylabel=\"x2\", zlabel=\"f(x)\",\n",
    "             color=:magma, camera=(45, 30))\n",
    "\n",
    "# 2. Create the Contour Plot (Level Curves)\n",
    "p2 = contour(x1_range, x2_range, f, \n",
    "             title=\"Level Curves (Contours)\", \n",
    "             xlabel=\"x1\", ylabel=\"x2\", \n",
    "             fill=true, color=:magma,\n",
    "             levels=15)\n",
    "\n",
    "# Combine both plots into one layout\n",
    "final_plot = plot(p1, p2, layout=(1, 2), size=(900, 400))\n",
    "\n",
    "# Save the resulting graphic\n",
    "display(final_plot)"
