    "\n",
    "# Define the function and its derivatives\n",
    "f(x) = 10*(x[1] - 3)^2 + 2*(x[2] - 2)^2\n",
    "grad_f(x) = [20*(x[1] - 3), 4*(x[2] - 2)]\n",
    "hess_f(x) = [20.0 0.0; 0.0 4.0]\n",
    "\n",
    "# Initial parameters\n",
    "x0 = [1.0, 1.0]\n",
    "tol = 1e-6\n",
    "max_iter = 100\n",
    "\n",
    "## 1. GRADIENT DESCENT (Fixed Step Size)\n",
    "function gradient_descent(x_start, alpha=0.05)\n",
    "    x = copy(x_start)\n",
    "    path = [copy(x)]\n",
    "    for i in 1:max_iter\n",
    "        g = grad_f(x)\n",
    "        if norm(g) < tol break end\n",
    "        x -= alpha * g\n",
    "        push!(path, copy(x))\n",
    "    end\n",
    "    return x, path\n",
    "end\n",
    "\n",
    "## 2. NEWTON METHOD\n",
    "function newton_method(x_start)\n",
    "    x = copy(x_start)\n",
    "    path = [copy(x)]\n",
    "    for i in 1:max_iter\n",
    "        g = grad_f(x)\n",
    "        H = hess_f(x)\n",
    "        if norm(g) < tol break end\n",
    "        x -= H \\ g  # Solves H*Δx = g, essentially x = x - inv(H)*g\n",
    "        push!(path, copy(x))\n",
    "    end\n",
    "    return x, path\n",
    "end\n",
    "\n",
    "# Run methods\n",
    "sol_gd, path_gd = gradient_descent(x0, 0.08) # alpha chosen to show zigzag\n",
    "sol_nt, path_nt = newton_method(x0)\n",
    "\n",
    "## VISUALIZATION\n",
    "x1_rng = range(0, 5, length=100)\n",
    "x2_rng = range(0, 4, length=100)\n",
    "z = [f([x1, x2]) for x1 in x1_rng, x2 in x2_rng]\n",
    "\n",
    "p = contour(x1_rng, x2_rng, z, fill=true, title=\"GD vs Newton: Elliptical Contours\", \n",
    "            xlabel=\"x1\", ylabel=\"x2\", levels=20)\n",
    "\n",
    "# Convert paths to matrices for plotting\n",
    "gd_pts = hcat(path_gd...)'\n",
    "nt_pts = hcat(path_nt...)'\n",
    "\n",
    "plot!(gd_pts[:,1], gd_pts[:,2], marker=:circle, label=\"Gradient Descent\", color=:white, lw=2)\n",
    "plot!(nt_pts[:,1], nt_pts[:,2], marker=:star, label=\"Newton Method\", color=:red, lw=2)\n",
    "\n",
    "display(p)\n",
    "\n",
    "println(\"GD Iterations: $(length(path_gd)-1)\")\n",
    "println(\"Newton Iterations: $(length(path_nt)-1)\")"
