    "    term3 = exp(1 / (x1 + x2))\n",
    "    \n",
    "    return term1 + term2 + term3\n",
    "end\n",
    "\n",
    "# 2. Gradient Descent with Backtracking Line Search\n",
    "function gradient_descent_backtracking(f, x0; \n",
    "    max_iter=1000, tol=1e-6, \n",
    "    alpha=1.0,  # Initial step size\n",
    "    rho=0.5,    # Shrink factor (0 < rho < 1)\n",
    "    c=1e-4      # Armijo condition constant\n",
    ")\n",
    "    x = copy(x0)\n",
    "    path = [copy(x)]\n",
