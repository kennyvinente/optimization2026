   "source": [
    "# Define the function and its derivatives\n",
    "f(x) = x[1]^2 + 100*x[2]^2\n",
    "grad_f(x) = [2*x[1], 200*x[2]]\n",
    "hess_f(x) = [2.0 0.0; 0.0 200.0]\n",
    "\n",
    "# Initial parameters\n",
