using JuMP
using Ipopt
using CSV
using DataFrames

# =========================
# 1. PASTA DOS MODELOS
# =========================
models_dir = raw"D:\Codigos\otimização\optimization2026\trabalho 1\models"

files = readdir(models_dir)

println("Arquivos encontrados: ", length(files))

# =========================
# 2. ARMAZENAR RESULTADOS
# =========================
results = DataFrame(
    model = String[],
    status = String[],
    objective = Float64[],
    x1 = Float64[],
    x2 = Float64[],
    x3 = Float64[],
    x4 = Float64[],
    x5 = Float64[],
    x6 = Float64[],
    x7 = Float64[],
    x8 = Float64[],
    x9 = Float64[],
    x10 = Float64[],
    x11 = Float64[]
)

# =========================
# 3. LOOP DOS MODELOS
# =========================
for file in files

    file_path = joinpath(models_dir, file)

    println("\n==============================")
    println("Rodando modelo: ", file)
    println("==============================")

    gams_text = read(file_path, String)

    model = Model(Ipopt.Optimizer)

    @variable(model, x[1:11] >= 0.001)
    @constraint(model, x[11] >= 0.01)

    c = [
        6.0557680362407096,
        17.130768036240699,
        34.020768036240703,
        5.8807680362407098,
        24.687768036240701,
        14.9527680362407,
        24.066768036240699,
        10.6747680362407,
        26.6287680362407,
        22.144768036240698
    ]

    @constraint(model, sum(x[i] for i in 1:10) == x[11])

    @constraint(model, x[3] + x[7] + x[8] + 2x[9] + x[10] == 1)
    @constraint(model, x[4] + 2x[5] + x[6] + x[7] == 1)
    @constraint(model, x[1] + 2x[2] + 2x[3] + x[6] + x[10] == 2)

    @NLobjective(model, Min,
        sum(x[i] * (log(x[i] / x[11]) - c[i]) for i in 1:10)
    )

    optimize!(model)

    # =========================
    # 4. RESULTADOS
    # =========================
    status = string(termination_status(model))
    obj = objective_value(model)
    xv = value.(x)

    println("Status: ", status)
    println("Objetivo: ", obj)

    # =========================
    # 5. SALVAR NA TABELA
    # =========================
    push!(results, (
        file,
        status,
        obj,
        xv[1], xv[2], xv[3], xv[4], xv[5],
        xv[6], xv[7], xv[8], xv[9], xv[10], xv[11]
    ))

end

# =========================
# 6. EXPORTAR RELATÓRIO
# =========================
output_file = "relatorio_resultados.csv"
CSV.write(output_file, results)

println("\n==============================")
println("RELATÓRIO GERADO: ", output_file)
println("==============================")